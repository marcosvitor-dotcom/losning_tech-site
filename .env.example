# Conexão com o MongoDB Atlas (banco losning_crm) — usado para captura de leads
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Envio de e-mail de notificação de novos leads (SMTP — Google Workspace)
# Conta REMETENTE: admin@losningtech.com.br (precisa ter verificação em 2 etapas)
# Gere uma "Senha de App" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@losningtech.com.br
SMTP_PASS=sua-senha-de-app-de-16-digitos-sem-espacos
# DESTINATÁRIO que recebe a notificação do lead
LEAD_NOTIFICATION_TO=comercial@losningtech.com.br
